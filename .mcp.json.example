{
  "_comment": "Copy to .mcp.json (gitignored) and fill ULUOPS_API_KEY (Claude Code expands ${VAR} from the shell at launch; a literal key in its place also works). The tracker project `codebase-as-structure` lives in the ulu-labs org since Alex moved it there (confirmed 2026-11-11; through 2026-09 it was in the personal org of the personal key). ULUOPS_ORG_SLUG on the tracker entry makes ulu-labs the default; without it the server falls back to the personal org, where the project is not found and save_run would create a second one. Both servers run from the global npm install; the registry's old source path was moved.",
  "mcpServers": {
    "uluops-tracker": {
      "command": "node",
      "args": [
        "/Users/aself/.nvm/versions/node/v24.14.1/lib/node_modules/@uluops/ops-mcp/dist/index.js"
      ],
      "env": {
        "ULUOPS_BASE_URL": "https://api.uluops.ai/api/v1",
        "ULUOPS_ORG_SLUG": "ulu-labs",
        "ULUOPS_API_KEY": "${ULUOPS_API_KEY}"
      }
    },
    "uluops-registry": {
      "command": "node",
      "args": [
        "/Users/aself/.nvm/versions/node/v24.14.1/lib/node_modules/@uluops/registry-mcp/dist/index.js"
      ],
      "env": {
        "ULUOPS_API_KEY": "${ULUOPS_API_KEY}",
        "ULUOPS_ORG_SLUG": "ulu-labs",
        "TOOL_POLICIES_PATH": "/Users/aself/.nvm/versions/node/v24.14.1/lib/node_modules/@uluops/registry-mcp/tool-policies.json",
        "WORKSPACE_DIR": "/Users/aself/uluops"
      }
    }
  }
}
